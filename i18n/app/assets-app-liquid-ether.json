 {
  "pt": "float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453123);}",
  "tipo": "exato",
  "ignorar": true
 },
 {
  "pt": "float noise(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.0-2.0*f);return mix(mix(hash(i),hash(i+vec2(1.,0.)),f.x),mix(hash(i+vec2(0.,1.)),hash(i+vec2(1.,1.)),f.x),f.y);}",
  "tipo": "exato",
  "ignorar": true
 },
 {
  "pt": "float fbm(vec2 p){float v=0.0,a=.5;mat2 r=mat2(.80,.60,-.60,.80);for(int i=0;i<4;i++){v+=a*noise(p);p=r*p*2.03+3.1;a*=.5;}return v;}",
  "tipo": "exato",
  "ignorar": true
 },
 {
  "pt": "vec3 current(vec2 uv,vec2 center,vec3 color,float phase,float width){vec2 p=uv-center;float n=fbm(p*2.4+vec2(phase*.14,-phase*.08));float path=.13*sin(p.y*3.1+phase)+.045*sin(p.y*7.7-phase*1.3)+.10*(n-.5);float d=abs(p.x-path);float ribbon=exp(-pow(d/width,2.0));float fade=exp(-pow(abs(p.y)/.57,4.0));float fold=.72+.28*sin(p.y*10.0+phase*1.4+n*4.0);return color*ribbon*fade*fold;}",
  "tipo": "exato",
  "ignorar": true
 },
 {
  "pt": "void main(){",
  "tipo": "exato",
