  "ignorar": true
 },
 {
  "pt": "vec2 left=vec2(-spread+.05*sin(t*.43),.12*sin(t*.62));vec2 right=vec2(spread+.06*sin(t*.51+2.0),-.12*sin(t*.57));",
  "tipo": "exato",
  "ignorar": true
 },
 {
  "pt": "float pd=length(uv-pointer);vec2 bend=normalize(u_velocity+vec2(.0001))*.12*exp(-pd*4.5)*u_interaction;uv+=bend*sin(pd*18.0-t*4.0);",
  "tipo": "exato",
  "ignorar": true
 },
 {
  "pt": "vec3 blue=vec3(.208,.333,.396),teal=vec3(.373,.663,.608),orange=vec3(.914,.529,.369),col=vec3(0.0);",
  "tipo": "exato",
  "ignorar": true
 },
 {
  "pt": "col+=current(uv,left,blue,t,.085);col+=current(uv,left+vec2(.085,-.02),teal*.35,t+1.4,.048);",
