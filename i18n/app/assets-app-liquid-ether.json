  "ignorar": true
 },
 {
  "pt": "float touch=exp(-pd*5.5)*u_interaction;col+=mix(teal,orange,.5+.5*sin(t*1.6))*touch*(.28+.18*sin(pd*28.0-t*6.0));",
  "tipo": "exato",
  "ignorar": true
 },
 {
