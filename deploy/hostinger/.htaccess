# =============================================================
# OAZE — configuração do Apache na Hostinger
# -------------------------------------------------------------
# Vai para a raiz de public_html, junto com os arquivos do site.
#
# A ORDEM DAS REGRAS IMPORTA. Redirecionar antes de reescrever, e
# reescrever só o que não é arquivo. Trocar essa ordem faz um CSS
# virar HTML e a página abrir sem estilo — sem erro nenhum no log.
# =============================================================

# -------------------------------------------------------------
# 1 · HTTPS e domínio canônico
# -------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP → HTTPS. A Hostinger termina TLS antes do Apache, então o
  # sinal confiável é o cabeçalho do proxy, não HTTPS=on.
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # www → domínio principal. Um endereço só: dois endereços são
  # duas sessões, dois cookies e duas entradas no índice de busca.
  #
  # Esta regra é genérica de propósito — casa qualquer host que
  # comece com www e redireciona para o mesmo host sem ele. Não
  # precisa saber qual é o domínio, então continua correta depois
  # de apontar o domínio próprio.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # -----------------------------------------------------------
  # 2 · rotas públicas → documentos próprios
  # -----------------------------------------------------------
  # Cada página pública é um arquivo HTML de verdade, com <title>,
  # meta description e canônica próprias. Isso não é preferência
  # estética: uma SPA entrega o mesmo HTML para todas as rotas, e
  # aí só existe um título e uma descrição para o site inteiro.
  #
  # O [L] encerra o processamento de cada uma — sem ele a regra
  # seguinte reescreveria por cima.
  # -----------------------------------------------------------
  # 2a · as mesmas rotas em inglês, francês e espanhol
  # -----------------------------------------------------------
  # /en, /fr e /es são pastas de verdade, geradas por
  # tools/gen-idiomas.js a partir das páginas em português. Os nomes
  # das rotas continuam os mesmos (/en/precos, não /en/pricing):
  # mudar o caminho por idioma dobraria a tabela de rotas e quebraria
  # todo link já compartilhado. Estas regras vêm ANTES das rotas em
  # português — sem isso, /en/precos cairia no fallback do app.
  RewriteRule ^(en|fr|es)/?$                       /$1/index.html [L]
  RewriteRule ^(en|fr|es)/(recursos|precos|entrar|cadastro|recuperar-senha|redefinir-senha|confirmar-email|privacidade|termos|suporte)/?$  /$1/$2.html [L]

  RewriteRule ^recursos/?$          /recursos.html        [L]
  RewriteRule ^precos/?$            /precos.html          [L]
  RewriteRule ^entrar/?$            /entrar.html          [L]
  RewriteRule ^cadastro/?$          /cadastro.html        [L]
  RewriteRule ^recuperar-senha/?$   /recuperar-senha.html [L]
  RewriteRule ^redefinir-senha/?$   /redefinir-senha.html [L]
  RewriteRule ^confirmar-email/?$   /confirmar-email.html [L]
  RewriteRule ^privacidade/?$       /privacidade.html     [L]
  RewriteRule ^termos/?$            /termos.html          [L]
  RewriteRule ^suporte/?$           /suporte.html         [L]

  # -----------------------------------------------------------
  # 3 · rotas do aplicativo → app.html
  # -----------------------------------------------------------
  # /app e /onboarding são estados do aplicativo, não
  # arquivos. O Apache entrega o app.html e o JavaScript decide o
  # que mostrar — inclusive se a pessoa pode estar ali.
  #
  # ISTO NÃO É A PROTEÇÃO DA ROTA. Qualquer um pode pedir /app e
  # receber este HTML; o que ele NÃO recebe é dado. A proteção de
  # verdade é o RLS no banco, que devolve zero linhas para quem não
  # tem sessão. Um guarda no servidor de arquivos estáticos seria
  # teatro: não há sessão para ele consultar.
  #
  # A CONDIÇÃO DE EXTENSÃO NÃO É OPCIONAL. Sem ela,
  # /app/assets/js/app.js casa com ^app(/.*)$ e recebe o app.html
  # com status 200 — o navegador tenta executar HTML como
  # JavaScript e o console enche de "Unexpected token '<'".
  # (Aconteceu: 41 scripts, 41 erros. O app até funcionava, porque
  # os caminhos são absolutos e havia um segundo pedido correto,
  # mas cada arquivo era baixado duas vezes.)
  RewriteCond %{REQUEST_URI} !\.(css|js|mjs|map|json|txt|xml|html|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot|zip|webmanifest)$ [NC]
  RewriteRule ^app(/.*)?$         /app.html [L]
  RewriteCond %{REQUEST_URI} !\.(css|js|mjs|map|json|txt|xml|html|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot|zip|webmanifest)$ [NC]
  RewriteRule ^onboarding(/.*)?$  /app.html [L]
  # -----------------------------------------------------------
  # 4 · fallback da raiz
  # -----------------------------------------------------------
  # Só o que não é arquivo nem diretório de verdade. Sem estas duas
  # condições, /assets/css/style.css devolveria HTML.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # Arquivo com extensão de asset que não existe é ERRO, não rota.
  # Sem esta linha, /assets/js/algo.js digitado errado devolvia o
  # index.html com status 200: o navegador recusava por MIME e a
  # página abria sem estilo, sem nada no log dizendo o porquê. Uma
  # rota do site nunca tem extensão, então excluí-las não custa nada.
  RewriteCond %{REQUEST_URI} !\.(css|js|mjs|map|json|txt|xml|html|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot|zip|webmanifest)$ [NC]
  RewriteRule ^$ /index.html [L]
</IfModule>

# -------------------------------------------------------------
# 5 · página de erro
# -------------------------------------------------------------
# Qualquer caminho que não casou com nada acima cai aqui. Com as
# rotas explícitas da seção 2, um endereço inventado é 404 de
# verdade — e não a landing devolvida com status 200, que é o pior
# dos dois mundos: o usuário não entende e o buscador indexa lixo.
ErrorDocument 404 /404.html

# -------------------------------------------------------------
# 6 · cabeçalhos de segurança
# -------------------------------------------------------------
<IfModule mod_headers.c>
  # ---- CSP ----
  # Esta é a única CSP do projeto. Ela vale para o site publicado;
  # em file:// e no servidor local não há CSP nenhuma, então uma
  # integração nova pode funcionar no desenvolvimento e ser
  # bloqueada aqui. Ao acrescentar destino, mexa em connect-src.
  #
  # api.anthropic.com FOI REMOVIDO. O navegador não fala com
  # provedor de IA nenhum: a UGLEZ chama a Edge Function
  # oaze-assistant, que é *.supabase.co, e é ela quem fala com o
  # provedor. Deixar o domínio liberado seria manter aberta uma
  # porta que ninguém usa.
  #
  # gstatic e apis.google.com saíram com o Firebase: existiam só
  # para o SDK dele. accounts.google.com fica — é o "entrar num
  # toque" do Google, e ele precisa de script, estilo, conexão e
  # iframe, os quatro.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' data: https://*.googleusercontent.com; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.supabase.in wss://*.supabase.in https://cdn.jsdelivr.net https://accounts.google.com https://*.googleapis.com; frame-src https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"

  # O login com Google abre um pop-up e precisa conversar com ele.
  # same-origin puro quebraria esse retorno.
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # ---- HSTS ----
  # LIGADO, com prazo curto e SEM includeSubDomains e SEM preload.
  #
  # Isso é deliberado. O HTTPS está confirmado funcionando neste
  # host (a regra da seção 1 redireciona e o certificado responde),
  # então um ano de HSTS na raiz é seguro. Mas includeSubDomains
  # obrigaria HTTPS em subdomínios que talvez ainda não existam nem
  # tenham certificado — e o navegador guardaria essa exigência por
  # um ano, sem como voltar atrás do lado do servidor.
  #
  # AO APONTAR O DOMÍNIO PRÓPRIO: confirme o HTTPS em todos os
  # subdomínios que for usar, e só então acrescente
  # includeSubDomains. preload só depois disso, e é irreversível na
  # prática.
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# -------------------------------------------------------------
# 6b · tipos que o Apache não conhece
# -------------------------------------------------------------
# O .webmanifest é recente e não está na tabela padrão do servidor
# da Hostinger: sem esta linha ele sai como text/plain, e o
# navegador RECUSA instalar o app com o tipo errado. Nada quebra
# visivelmente — o botão "instalar" simplesmente nunca aparece, e
# não há erro em lugar nenhum que explique por quê.
# (Verificado no ar: /manifest.webmanifest voltava text/plain.)
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  # Pelo mesmo motivo, e porque o SVG do favicon precisa do tipo
  # certo para o navegador aceitá-lo como ícone.
  AddType image/svg+xml .svg
</IfModule>

# -------------------------------------------------------------
# 7 · cache
# -------------------------------------------------------------
# O HTML nunca é guardado: é ele que aponta para o resto, e um HTML
# velho em cache serve um app velho inteiro. Os arquivos de assets
# revalidam — o projeto não usa nome com hash, então cache longo
# aqui significaria CSS antigo depois de um deploy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(woff2|svg|png|jpg|webp|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # O manifesto aponta ícones e nome; se ficar preso em cache, uma
  # troca de identidade não chega em quem já instalou.
  <FilesMatch "\.(webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# -------------------------------------------------------------
# 8 · compressão
# -------------------------------------------------------------
# O arquivo único passa de 1 MB; comprimido cai para perto de um
# quinto. Em rede móvel isso é a diferença entre abrir e desistir.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# -------------------------------------------------------------
# 9 · o que não deve ser servido
# -------------------------------------------------------------
# Nenhum destes arquivos vai no pacote de deploy, mas a regra é
# barata e cobre o dia em que alguém subir a pasta inteira por
# engano.
<FilesMatch "^\.env|\.md$|\.sql$|\.ps1$|\.ts$|package(-lock)?\.json$">
  Require all denied
</FilesMatch>

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
